# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code / local agent state
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# local brand assets, design files, sensitive notes — never commit (not part of the deployed app).
# Root-anchored so they don't affect real site assets under /public.
/Branding/
/Daily Content Sweeps/
/Images/
/logo-files/
/Suor Society Design System_files/
/recovery-codes.txt
/test_write.txt
/*.mp4
/*.png
/*.jpeg
/*.jpg
/*.webp
/*.pdf
